# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.islqosj.mongodb.net/test?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Client Frontend URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Nodemailer / SMTP Email (For OTP verification & order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ElectroZone <noreply@electrozone.com>

# Razorpay Payment Gateway (Optional / Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
